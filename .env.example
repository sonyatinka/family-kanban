# Copy to .env: cp .env.example .env

# Docker Compose
POSTGRES_USER=family
POSTGRES_PASSWORD=family
POSTGRES_DB=family_kanban

# API
PORT=3000
DATABASE_URL=postgresql://family:family@localhost:5432/family_kanban
REDIS_URL=redis://localhost:6379
# Secret for signing access tokens (JWT, HS256). Generate a random one for your machine:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
